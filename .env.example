# Copy to .env and set real values. .env is not committed.
# All variables are required; docker compose refuses to start if one is missing.

# GeoServer admin account (web UI and REST API)
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change-me

# Host address for GeoServer's own port 8080 (admin UI + REST API).
# Production: 127.0.0.1 (reach it via SSH tunnel). Local dev: 127.0.0.1 or 0.0.0.0.
GEOSERVER_BIND_ADDRESS=127.0.0.1

# Public port of the nginx proxy. Exposes only WMS and WMTS (GET/HEAD).
PROXY_PORT=8088

# true = web admin UI disabled (production). false = UI available at /geoserver/web
GEOSERVER_DISABLE_WEB_INTERFACE=true

# PostGIS granule index database. Only applied when the postgis_data volume is first created.
POSTGIS_DB=radar
POSTGIS_USER=radar
POSTGIS_PASSWORD=change-me
